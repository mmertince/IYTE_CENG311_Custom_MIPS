01101010  // blt opcode (106)
00000011  // $0=0, $s2=3
00000000  // unused
00000100  // offset=4 (EXIT at addr 12, PC+4+4*1=12)

01100110  // move opcode (102)
00100011  // $s0=1, $s2=3
00000000  // unused
00000010  // funct=2 (MOVE)

01100110  // or opcode (102)
00110100  // $s0=1, $s0=1, $s3=4
00000000  // unused
00000100  // funct=4 (OR)

01100111  // subi opcode (107)
00100010  // $s1=2, $s1=2
00000000  // unused
00000010  // imm=2