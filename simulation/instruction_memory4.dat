// Byte order in .dat: each instruction uses 4 lines = 4 bytes
// byte0: opcode[31:24]
// byte1: {rs[23:20], rt[19:16]} (upper nibble = rs, lower = rt)
// byte2: R-type -> {rd[15:12], shamt[11:8]} | I/B-I -> imm[15:8]
// byte3: R-type -> {shamt[7:6], funct[5:0]} | I/B-I -> imm/offset[7:0]
// BEQI compares rs against immediate[7:0]; branches to target using PC-relative offset:
//   target = (PC + 4) + signext(offset[7:0]) * 4
// J-type (opcode 0xEE): bytes1–3 hold 24-bit word address (target >> 2)

// 0: addi $sp, $sp, -4
01101100  // addi opcode (108)
11101110  // rs=$sp(14), rt=$sp(14)
11111111  // sign extended -4 
11111100

// 4: sw $t0, 0($sp)
// After SP = -4, physical addr = spba(40) + sp = 36; use offset=40 so rs(-4)+40=36
01101000  // sw opcode (104)
11100110  // rs=$sp(14), rt=$t0(6)
00000000  // offset MSB
00101000  // offset = 40 spba

// 8: addi $sp, $sp, -4
01101100  // addi opcode (108)
11101110  // rs=$sp(14), rt=$sp(14)
11111111  // sign extended -4
11111100  //sign extended -4

// 12: sw $t1, 0($sp) - needs offset 40
01101000  // sw opcode (104)
11100111  // rs=$sp(14), rt=$t1(7)
00000000  // offset MSB
00101000  // offset = 40

// 16: lw $sp, -4($sp)
01100111  // lw opcode (103)
11101110  // rs=$sp(14), rt=$sp(14)
00000000  // offset MSB
00100100  // offset = 36 (40 - 4)

// 20: sw $t2, 0($sp) - needs offset 40
01101000  // sw opcode (104)
11101000  // rs=$sp(14), rt=$t2(8)
00000000  // offset MSB
00101000  // offset = 40

// 24: beq $t0, $t0, 0 (infinite loop)
01101001  // beq opcode (105)
01100110  // rs=$t0(6), rt=$t0(6)
00000000  // offset = 0
00000000  // offset = 0