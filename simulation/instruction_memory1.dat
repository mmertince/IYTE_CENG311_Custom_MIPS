// Byte order in .dat: each instruction uses 4 lines = 4 bytes
// byte0: opcode[31:24]
// byte1: {rs[23:20], rt[19:16]} (upper nibble = rs, lower = rt)
// byte2: R-type -> {rd[15:12], shamt[11:8]} | I/B-I -> imm[15:8]
// byte3: R-type -> {shamt[7:6], funct[5:0]} | I/B-I -> imm/offset[7:0]
// BEQI compares rs against immediate[7:0]; branches to target using PC-relative offset:
//   target = (PC + 4) + signext(offset[7:0]) * 4
// J-type (opcode 0xEE): bytes1–3 hold 24-bit word address (target >> 2)

// 0: lw $s2, 0($t2)
01100111  // lw opcode (103)
10000011  // rs=$t2(8), rt=$s2(3)
00000000  // offset[15:8] = 0
00000000  // offset[7:0] = 0

// 4: add $s4, $s2, $s0
01100110  // R-type opcode (102)
00110001  // rs=$s2(3), rt=$s0(1)
01010000  // rd=$s4(5), shamt[11:8]=0
00000101  // shamt[7:6]=0, funct=5 (ADD)

// 8: beqi $s2, 4, EXIT (target addr 32 -> offset = (32-12)/4 = 5)
01101101  // beqi opcode (109)
00110000  // rs=$s2(3), rt=0 (ignored)
00000100  // imm = 4 (compare)
00000101  // offset = 5

// 12: sw $s4, 8($0)
01101000  // sw opcode (104)
00000101  // rs=$0(0), rt=$s4(5)
00000000  // offset[15:8] = 0
00001000  // offset[7:0] = 8

// 16: blt $s4, $s2, NEXT_LOAD (target 24 -> offset = (24-20)/4 = 1)
01101010  // blt opcode (106)
01010011  // rs=$s4(5), rt=$s2(3)
00000000  // offset[15:8] = 0
00000001  // offset[7:0] = 1

// 20: j EXIT (addr 32 -> word 8)
01101110
00000000  // addr[23:16] = 0
00000000  // addr[15:8] = 0
00001000  // addr[7:0]  = 8

// 24: NEXT_LOAD: addi $t2, $t2, 4
01101100  // addi opcode (108)
10001000  // rs=$t2(8), rt=$t2(8)
00000000  // imm[15:8] = 0
00000100  // imm[7:0]  = 4

// 28: j START (addr 0)
01101110
00000000  // addr[23:16] = 0
00000000  // addr[15:8] = 0
00000000  // addr[7:0]  = 0

// 32: EXIT: beq $t2, $t2, 0
01101001  // beq opcode (105)
10001000  // rs=$t2(8), rt=$t2(8)
00000000  // offset[15:8] = 0
00000000  // offset[7:0]  = 0
